# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - never commit it.

aws_region   = "eu-north-1"
project_name = "codesimplify"

# Create this first with:
#   aws ec2 create-key-pair --region eu-north-1 --key-name codesimplify \
#     --query "KeyMaterial" --output text > codesimplify.pem
key_name = "codesimplify"

# Restrict this to your own IP! Find it with:
#   curl -s https://checkip.amazonaws.com
ssh_ingress_cidr = "203.0.113.4/32"
